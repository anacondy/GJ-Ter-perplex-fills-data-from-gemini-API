# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)
#
# Get a key at https://aistudio.google.com/apikey

# Required only for live Gemini runs. `--offline` needs no key at all.
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# GJTER_DB_PATH=jobs.db
# GJTER_MODEL=gemini-2.5-flash
# GJTER_BATCH_SIZE=5
# GJTER_BATCH_PAUSE=20
# GJTER_MAX_RETRIES=4
